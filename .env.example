# Google Gemini — used for both LLM generation AND embeddings (text-embedding-004)
# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase — vector database (pgvector)
# Create a free project at https://supabase.com
# Then run schema.sql in the SQL Editor (instructions in README).
# Use the SERVICE ROLE key (not the anon key) — it's server-side only and bypasses RLS.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
